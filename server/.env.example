DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
APP_JWT_SECRET=change-me-to-a-secure-secret-min-32-chars
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Local demo without Alien host
DEV_BYPASS_AUTH=true

# Optional: Purchase confirmation email (Resend)
# Get API key at https://resend.com — use a verified domain for RESEND_FROM in production
# RESEND_API_KEY=
# RESEND_FROM=Fair Ticket Queue <tickets@yourdomain.com>

# Optional: Apify drop monitor
# APIFY_TOKEN=
# APIFY_DROP_URL=
